# ESP32-S3-Touch-LCD-2.8 (ESP32-S3R8, 8 MB octal PSRAM, 16 MB flash).
#
# NOTE: ESP-IDF applies this file only when it CREATES sdkconfig. An existing
# sdkconfig always wins, so editing this file and rebuilding changes nothing --
# delete sdkconfig.s3 to make changes here take effect.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console on native USB-Serial-JTAG, NOT UART0.
#
# Two reasons. There is no USB-serial bridge chip on this board -- USB-C goes
# straight to GPIO19/20 -- and UART0 (IO43/IO44) is the link to the ATmega328,
# so leaving the console there would have the log fighting the AT protocol on
# the same wires.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# PSRAM deliberately OFF for now.
#
# Milestone 1 does not need it, and this chip's PSRAM is OCTAL while the S3
# Kconfig defaults to quad/40 MHz -- a wrong setting stops the board booting.
# Keeping it out of the first flash means a boot failure can only be our code.
# Enable together with the LVGL buffers, and not at 120 MHz: that is gated
# behind experimental flags and warns of corruption after a ~20 C temperature
# swing, which is exactly what a car interior does.
# CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_SPEED_80M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
