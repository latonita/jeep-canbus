# ESP32-S3-Touch-LCD-2.8 (ESP32-S3R8, 8 MB octal PSRAM, 16 MB flash).
#
# NOTE: ESP-IDF applies this file only when it CREATES sdkconfig. An existing
# sdkconfig always wins, so editing this file and rebuilding changes nothing --
# delete sdkconfig.s3 to make changes here take effect.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console on native USB-Serial-JTAG, NOT UART0.
#
# Two reasons. There is no USB-serial bridge chip on this board -- USB-C goes
# straight to GPIO19/20 -- and UART0 (IO43/IO44) is the link to the ATmega328,
# so leaving the console there would have the log fighting the AT protocol on
# the same wires.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# PSRAM deliberately OFF for now.
#
# Milestone 1 does not need it, and this chip's PSRAM is OCTAL while the S3
# Kconfig defaults to quad/40 MHz -- a wrong setting stops the board booting.
# Keeping it out of the first flash means a boot failure can only be our code.
# Enable together with the LVGL buffers, and not at 120 MHz: that is gated
# behind experimental flags and warns of corruption after a ~20 C temperature
# swing, which is exactly what a car interior does.
# CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_SPEED_80M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# ---- Render speed -------------------------------------------------------
#
# A full-screen frame measured 65 ms, of which only 15 ms is the SPI link at
# 80 MHz -- the other 50 ms is the memory system, not draw maths. A scroll
# frame walks LVGL's whole refresh/blend/mask path plus 69 KB of uncompressed
# 4 bpp glyph data, all executed and read straight out of flash.
#
# Idle frames are 4.5 ms because one small label stays cache-resident. That
# cliff is the tell: it is cache misses, not pixels.
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y

# Flash in QIO rather than DIO: 4 data lines instead of 2, ~40 MB/s instead of
# ~20. The glyph bitmaps are 69 KB of uncompressed 4 bpp .rodata re-streamed
# from flash on every full-screen frame, so the fill rate is felt directly.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# The SPI master's transmit functions in IRAM, not just its ISR. A full-screen
# frame queues one transaction per flush chunk and drains the queue on every
# CASET/RASET, so this path is walked several times a frame -- and it was being
# fetched from flash each time.
CONFIG_SPI_MASTER_IN_IRAM=y

# NOT the 32 KB instruction cache. It links and it flashes and then the board
# BOOT LOOPS -- silently, because the console is native USB-Serial-JTAG, so
# each reset tears the port down before anything can print. The cache is carved
# out of internal SRAM at startup, so this is a failure that cannot show up at
# link time. Measured, reverted, and left here as a warning: if the render is
# ever short of memory bandwidth again, this is not the lever.

# ONE software draw unit, not two.
#
# LVGL creates its draw threads with plain xTaskCreate -- no affinity -- at
# CONFIG_LV_DRAW_THREAD_PRIO (3), which is BELOW carTask's 5 on core 0. So a
# draw worker routinely lands on core 0 and is preempted by the link task's
# long blocking UART reads. uiInit() pins the esp_lvgl_port task to core 1, but
# that is the coordinator; with LV_USE_OS the pixels are drawn on these
# threads. Two of them doubles the exposure and adds a FreeRTOS notify round
# trip per draw task for no gain at a 48-row partial buffer.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1

# LVGL pool. 64 KB rendered the six-page tree but could not always allocate a
# draw task on top of it -- LV_ASSERT_MALLOC is a bare while(1), so that is a
# silent freeze with a white panel, not an error. 128 is TOO FAR: the pool is
# .bss, and taking it starves the internal DMA heap the two 38 KB draw buffers
# come from -- esp_lvgl_port then fails buf2 and there is no display at all.
# See CLAUDE.md.
CONFIG_LV_MEM_SIZE_KILOBYTES=112

# The task watchdog must RESET, not just log. It fired every five seconds
# through an LV_ASSERT_MALLOC while(1) and printed a backtrace for ever while
# the panel stayed frozen -- a watchdog that only complains is a log line.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=2
