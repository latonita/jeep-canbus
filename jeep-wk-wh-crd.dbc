CM_ "Jeep Grand Cherokee WK/WH 3.0 CRD, CAN-B interior bus 83.333 kbit/s, 11-bit IDs. Confidence attribute per signal.";
CM_ BU_ CCN "Cluster / cab compartment node";
CM_ BU_ WCM "Wireless control module (SKREEM/RKE/TPMS)";
CM_ BU_ RAR "Factory RAR radio (replaced 2026-11-04 by Android unit + CAN box)";
CM_ BU_ CANBOX "Aftermarket CAN box for the Android head unit";
CM_ BU_ VES "Video entertainment system (injected command only)";
CM_ SG_ 0 IgnitionState "Key/ignition state (bit0 = key present, probable)";
CM_ BO_ 0 "Ignition / key state";
CM_ SG_ 2 EngineRPM "Engine speed, 1 rpm/count; FFFF = n/a";
CM_ SG_ 2 VehicleSpeed "Vehicle speed raw/128 km/h; FFFF = n/a";
CM_ SG_ 2 WheelDistLeft "Left-wheel distance counter, rolling u16, ~24.9 counts/m (= ABS 2151 / CCN 213E left)";
CM_ SG_ 2 WheelDistRight "Right-wheel distance counter, rolling u16, ~24.9 counts/m (= ABS 2151 / CCN 213E right)";
CM_ BO_ 2 "RPM, speed, wheel distance pulses; all FF = unavailable";
CM_ SG_ 3 Lamp_ESP_Off "ESP lamp steady = ESP disabled (button or 4WD Low)";
CM_ SG_ 3 Lamp_WaitToStart "Glow-plug lamp";
CM_ SG_ 3 AC_CompressorOn "Same as 0EC b0";
CM_ SG_ 3 Cruise_Engaged "Cruise speed set";
CM_ SG_ 3 Cruise_On "Cruise armed";
CM_ SG_ 3 GearSelector "Selector lever (fixed 0x80 + range); all AutoStick ranges = 84";
CM_ SG_ 3 PRNDL_Display "PRNDL ASCII shown on cluster";
CM_ SG_ 3 FourWD_Low "4WD Low engaged (4LO telltale)";
CM_ SG_ 3 TransferCaseShifting "Transfer-case shift in progress / 4WD lever pulled";
CM_ BO_ 3 "Cluster telltales + gear selector; b0/b1/b4 = CCN KWP 213F bytes 2/3/7";
CM_ SG_ 6 TurnRight "Both turn bits = hazard";
CM_ SG_ 6 RAP_Active "Retained accessory power; held after OFF, cleared by door open (key out) or RAP timeout";
CM_ SG_ 6 PowerMode_Bit5 "Set at ACC before RAP bit, survives crank, clears first at timeout";
CM_ SG_ 6 CCN_SettingsFlags "Usually 04; CCN settings flag byte, mapping unknown";
CM_ SG_ 6 ApproachLightTime "Illuminated-approach time";
CM_ SG_ 6 HeadlampOffDelay "Headlamp off-delay time";
CM_ SG_ 6 RAP_Delay "Power-accessory (RAP) delay, 0x258 = 600 s";
CM_ BO_ 6 "Lights, indicators, RAP, CCN settings; b2..b6 = CCN KWP 2133 bytes 3..7";
CM_ BO_ 8 "Static/unknown: 00 00 80 80 00 00";
CM_ SG_ 16 AliveToggle_010 "Toggles together in 010/011/110/1AD/1AF shared burst";
CM_ BO_ 16 "Static/unknown: 41 01 15 71 63 80 2A 03";
CM_ SG_ 17 AliveToggle_011 "Toggles together in 010/011/110/1AD/1AF shared burst";
CM_ BO_ 17 "Static/unknown: 3D 13 00 03 8B 40 00 00";
CM_ SG_ 18 RKE_BasicRequest "01 around a fob unlock";
CM_ SG_ 18 RKE_ComplexRequest "Probably RKE complex request / fob number";
CM_ SG_ 18 SKIM_KeyNumber "SKIM key number in ignition, 0 = key out";
CM_ SG_ 18 TPM_ChimeRequest "Injecting it did not chime";
CM_ SG_ 18 KeyAuthData "49 99 only during key-authorisation burst";
CM_ BO_ 18 "WCM key / RKE / chime status (= WCM KWP 2118 bytes 2..6)";
CM_ SG_ 19 DoorsValid "Data valid / module awake";
CM_ BO_ 19 "Doors ajar, driver seatbelt";
CM_ SG_ 20 Odometer "Odometer 0.1 km/count; FFFFFF = n/a";
CM_ SG_ 20 AmbientTempFiltered "Filtered outside temperature (dash value); FFFF = n/a";
CM_ SG_ 20 FuelSenderVoltage "Raw fuel-sender voltage (= CCN 2103); FF unless RUN";
CM_ BO_ 20 "Odometer, filtered outside temperature, fuel sender";
CM_ SG_ 21 AmbientTempRaw "Raw outside-temperature sensor (CCN 2134); heat-soaks when stopped";
CM_ SG_ 21 BatteryVoltage "Battery/charging voltage (CCN 2134)";
CM_ SG_ 21 Unknown_TempLike "Temperature-like value, not intake/charge air";
CM_ BO_ 21 "Raw outside temperature, battery voltage";
CM_ SG_ 27 VIN_Char01 "ASCII";
CM_ SG_ 27 VIN_Char02 "ASCII";
CM_ SG_ 27 VIN_Char03 "ASCII";
